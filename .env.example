# Copy to .env (never commit .env). All values optional; defaults shown.
# OAuth files live in secrets/ (see docs/PUBLISHING.md):
#   secrets/youtube_client_secret.json   (Desktop OAuth client from your own Google Cloud project)
#   secrets/youtube_token.json           (created on first upload)
#   secrets/youtube_analytics_token.json (created on first analytics run)
OLLAMA_HOST=http://localhost:11434
# Needed only for gated Hugging Face models (e.g. ai4bharat/indic-parler-tts). Create at https://huggingface.co/settings/tokens
HF_TOKEN=
